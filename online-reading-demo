<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>How Do Animals Move? --- 线上阅读产品 Demo</title>
<style>
/* ====== 基础 ====== */
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:#f4f1eb;color:#333;overflow:hidden;height:100vh}
#app{max-width:430px;margin:0 auto;height:100vh;display:flex;flex-direction:column;background:#fff;position:relative;box-shadow:0 0 40px rgba(0,0,0,.08)}

/* 顶栏 */
header{display:flex;align-items:center;padding:10px 14px;border-bottom:1px solid #eee;background:#fff;z-index:10}
.back{background:none;border:none;font-size:20px;cursor:pointer;padding:4px 8px;color:#888}
.progress{flex:1;height:6px;background:#eee;border-radius:3px;margin:0 10px;overflow:hidden}
.progress i{display:block;height:100%;background:#4ECDC4;border-radius:3px;transition:width .4s}
.step-label{font-size:12px;color:#999;white-space:nowrap}

/* 屏容器 */
.screen{display:none;flex:1;flex-direction:column;overflow-y:auto;padding:16px;-webkit-overflow-scrolling:touch}
.screen.active{display:flex}

/* 通用组件 */
.big-q{font-size:20px;font-weight:700;text-align:center;margin:24px 0 16px;line-height:1.4}
.btn{display:block;width:100%;padding:14px;border:none;border-radius:14px;font-size:17px;font-weight:700;cursor:pointer;text-align:center;margin:8px 0;transition:transform .1s}
.btn:active{transform:scale(.97)}
.btn-primary{background:#4ECDC4;color:#fff}
.btn-outline{background:#fff;color:#4ECDC4;border:2px solid #4ECDC4}
.btn-warm{background:#FF6B6B;color:#fff}
.hint{font-size:13px;color:#999;text-align:center;margin-top:8px}

/* 屏1 预测 */
.predict-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
.predict-card{border:3px solid #eee;border-radius:16px;padding:24px 8px;text-align:center;cursor:pointer;font-size:15px;font-weight:700;background:#fff;transition:all .2s}
.predict-card .emoji{font-size:48px;display:block;margin-bottom:8px}
.predict-card.picked{border-color:#4ECDC4;background:#e8faf8;transform:scale(1.05)}

/* 屏2 阅读 */
.page-view{flex:1;display:flex;flex-direction:column}
.page-img{flex:1;min-height:200px;border-radius:16px;background:#f0ede6;display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;overflow:hidden;margin-bottom:12px}
.page-img img{width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0}
.page-img .tag{position:absolute;top:10px;left:10px;background:rgba(255,255,255,.9);font-size:11px;padding:3px 8px;border-radius:8px;color:#888;z-index:2}
.sentence{font-size:22px;font-weight:700;text-align:center;line-height:1.6;margin:8px 0}
.word{display:inline-block;padding:2px 4px;border-radius:6px;cursor:pointer;transition:background .2s;user-select:none}
.word:hover{background:#fff3cd}
.word.lit{background:#FFD166;color:#000}
.controls{display:flex;gap:8px;margin-top:auto}
.controls .btn{flex:1;font-size:14px;padding:10px}
.page-dots{display:flex;justify-content:center;gap:6px;margin:10px 0}
.page-dots span{width:8px;height:8px;border-radius:50%;background:#ddd}
.page-dots span.on{background:#4ECDC4}

/* 屏3 选择题 */
.quiz-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:16px 0}
.quiz-opt{border:3px solid #eee;border-radius:16px;padding:20px 6px;text-align:center;cursor:pointer;font-size:13px;font-weight:700;background:#fff;transition:all .2s}
.quiz-opt .emoji{font-size:44px;display:block;margin-bottom:6px}
.quiz-opt.right{border-color:#4ECDC4;background:#e8faf8}
.quiz-opt.wrong{border-color:#FF6B6B;background:#fff0f0;animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.feedback{text-align:center;font-size:16px;font-weight:700;min-height:28px;margin:8px 0;color:#4ECDC4}

/* 屏4 排序 */
.slots{display:flex;gap:10px;justify-content:center;margin:16px 0}
.slot{width:90px;height:110px;border:3px dashed #ccc;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:28px;background:#fafafa;position:relative;cursor:pointer}
.slot.filled{border-style:solid;border-color:#4ECDC4;background:#e8faf8}
.slot .num{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#4ECDC4;color:#fff;font-size:11px;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}
.cards-pool{display:flex;gap:10px;justify-content:center;margin:12px 0;flex-wrap:wrap;min-height:96px}
.pool-card{width:80px;height:96px;border:3px solid #4ECDC4;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:28px;background:#fff;cursor:pointer;transition:transform .15s}
.pool-card.selected{transform:scale(1.08);box-shadow:0 0 0 3px #FFD166}
.pool-card.used{opacity:.3;pointer-events:none}

/* 屏5 摄像头 */
.cam-box{width:100%;aspect-ratio:4/3;background:#222;border-radius:16px;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center;margin-top:16px}
.cam-box video{width:100%;height:100%;object-fit:cover}
.cam-box .placeholder{color:#888;font-size:14px;text-align:center;padding:20px}
.recognized{margin-top:12px;text-align:center;font-size:20px;font-weight:700;min-height:32px;color:#4ECDC4}
.unlock-video{margin-top:12px;border-radius:16px;overflow:hidden;background:#e8faf8;color:#4ECDC4;text-align:center;padding:24px;display:none;font-weight:700}

/* 屏6 报告 */
.badges{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin:12px 0}
.badge{width:64px;height:64px;border-radius:50%;background:#eee;display:flex;align-items:center;justify-content:center;font-size:28px;filter:grayscale(1);opacity:.5}
.badge.got{background:#FFD166;filter:none;opacity:1}
.report-box{background:#f4f1eb;border-radius:14px;padding:14px;margin:12px 0;font-size:14px;line-height:1.8}
.report-box b{color:#4ECDC4}
.tabs{display:flex;border-bottom:2px solid #eee;margin-bottom:12px}
.tabs span{flex:1;text-align:center;padding:10px;font-size:14px;font-weight:700;cursor:pointer;color:#aaa}
.tabs span.on{color:#4ECDC4;border-bottom:2px solid #4ECDC4;margin-bottom:-2px}
.tab-pane{display:none}.tab-pane.on{display:block}
.audio-play{display:inline-flex;align-items:center;gap:6px;background:#4ECDC4;color:#fff;padding:6px 14px;border-radius:20px;font-size:13px;cursor:pointer;border:none}

/* 教研标注（可隐藏） */
.design-note{background:#fffbe6;border-left:3px solid #FFD166;padding:8px 12px;margin:12px 0;font-size:12px;color:#8a6d00;border-radius:0 8px 8px 0}
</style>
</head>
<body>
<div id="app">
  <header>
    <button class="back" id="backBtn" onclick="goBack()">‹</button>
    <div class="progress"><i id="bar" style="width:16%"></i></div>
    <div class="step-label" id="stepLabel">1/6</div>
  </header>

  <!-- 屏1 预测 -->
  <div class="screen active" id="s1">
    <div class="big-q">What can they do?</div>
    <p style="text-align:center;color:#888;font-size:14px">猜一猜，这些动物会做什么动作？</p>
    <div class="predict-grid" id="predictGrid">
      <div class="predict-card" data-v="jump" onclick="pick(this)"><span class="emoji">🐸</span>Frog</div>
      <div class="predict-card" data-v="swim" onclick="pick(this)"><span class="emoji">🐟</span>Fish</div>
      <div class="predict-card" data-v="slide" onclick="pick(this)"><span class="emoji">🐍</span>Snake</div>
      <div class="predict-card" data-v="hop" onclick="pick(this)"><span class="emoji">🐦</span>Bird</div>
    </div>
    <div class="design-note">💡 教研意图：非虚构读本入口必须是「提问」而非「认词」，先激活已有经验。</div>
    <button class="btn btn-primary" onclick="go(2)">开始阅读</button>
  </div>

  <!-- 屏2 沉浸阅读 -->
  <div class="screen" id="s2">
    <div class="page-view">
      <div class="page-img" id="pageImg">
        <span class="tag">真实摄影</span>
        <span id="pageEmoji">🐶</span>
      </div>
      <div class="page-dots" id="dots"></div>
      <div class="sentence" id="sentence"></div>
      <button class="btn btn-outline" style="padding:8px;font-size:13px" onclick="replaySentence()">🔊 听整句</button>
      <div class="controls">
        <button class="btn btn-outline" id="recBtn" onclick="toggleRec()">🎙️ 跟读</button>
        <button class="btn btn-primary" onclick="nextPage()">下一页 →</button>
      </div>
      <div class="hint" id="readHint">点单词可以听发音 · 读错的词会进「练习本」</div>
    </div>
  </div>

  <!-- 屏3 理解检测 -->
  <div class="screen" id="s3">
    <div class="big-q">Which one slides?</div>
    <div class="feedback" id="fb3"></div>
    <div class="quiz-grid">
      <div class="quiz-opt" onclick="quiz3(this,false)"><span class="emoji">🐦</span>Bird</div>
      <div class="quiz-opt" onclick="quiz3(this,true)"><span class="emoji">🐍</span>Snake</div>
      <div class="quiz-opt" onclick="quiz3(this,false)"><span class="emoji">🐟</span>Fish</div>
    </div>
    <div class="design-note">💡 点对自动前进；点错只抖动 + 重听原句。无扣分、无红叉、无倒计时。</div>
  </div>

  <!-- 屏4 排序（跨册衔接） -->
  <div class="screen" id="s4">
    <div class="big-q">Put the jump in order!</div>
    <p style="text-align:center;color:#888;font-size:13px">点击一张卡片，再点击一个位置放入</p>
    <div class="slots" id="slots">
      <div class="slot" data-i="0" onclick="slotClick(0)"></div>
      <div class="slot" data-i="1" onclick="slotClick(1)"></div>
      <div class="slot" data-i="2" onclick="slotClick(2)"></div>
    </div>
    <div class="cards-pool" id="pool"></div>
    <div class="feedback" id="fb4"></div>
    <div class="design-note">💡 画面复用 Fiction 册 P5「蹲---蹬---腾」三格分镜：同一个"跳"，从故事迁移到真实动物。</div>
    <button class="btn btn-primary" id="checkOrder" onclick="checkOrder()" style="display:none">检查</button>
  </div>

  <!-- 屏5 动作模仿 -->
  <div class="screen" id="s5">
    <div class="big-q">Show me: <span id="actionTarget" style="color:#4ECDC4">jump!</span></div>
    <div class="cam-box" id="camBox"><div class="placeholder">点击下方按钮开启摄像头<br>（本地文件打开可能受限）</div></div>
    <div class="recognized" id="recognized"></div>
    <div class="unlock-video" id="unlockVideo">🎉 Great job!<br><span style="font-size:14px;color:#888">青蛙解锁成功 → 播放真实跳跃视频 3 秒</span></div>
    <div style="display:flex;gap:8px;margin-top:12px">
      <button class="btn btn-outline" onclick="openCam()">📷 开摄像头</button>
      <button class="btn btn-primary" onclick="simulateAI()">🤖 模拟 AI 识别</button>
    </div>
    <div class="design-note">💡 TPR 线上化：输出靠身体而非背诵；失败不扣分，可无限重试。</div>
  </div>

  <!-- 屏6 收尾 + 报告 -->
  <div class="screen" id="s6">
    <div class="tabs">
      <span class="on" onclick="switchTab(0)">我的收获</span>
      <span onclick="switchTab(1)">家长报告</span>
    </div>
    <div class="tab-pane on" id="tab0">
      <div class="big-q" style="font-size:18px;margin:8px 0">I can say:</div>
      <div class="badges" id="badgeWall"></div>
      <div class="report-box">
        🎧 我的原声：<button class="audio-play" onclick="playMyVoice()">▶ 播放</button>
        <span id="voiceHint" style="color:#999;font-size:12px;margin-left:8px">还没录过音</span>
      </div>
      <div class="big-q" style="font-size:16px">Which book is REAL?</div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-outline" onclick="factAns(this,false)">Dance, Teddy, Dance!</button>
        <button class="btn btn-outline" onclick="factAns(this,true)">How Do Animals Move?</button>
      </div>
      <div id="factOk" style="display:none" class="report-box">✅ 对！Teddy 是想象的，青蛙是真的。</div>
      <button class="btn btn-warm" style="margin-top:16px" onclick="alert('已把任务推给老师：下节课 warm-up 表演给老师看')">🏫 下次课表演给老师看</button>
    </div>
    <div class="tab-pane" id="tab1">
      <div class="report-box" id="parentReport"></div>
      <div class="report-box"><b>家庭提问建议：</b>"Can a fish run?" 让孩子摇头说 No, it swims. / "Which one jumps like Teddy?"</div>
      <div class="design-note">💡 报告里同时出现 fiction 表现（上次会说 Let's dance），构成线上线下闭环证据。</div>
    </div>
  </div>
</div>

<script>
/* ===== TTS 发音引擎 (浏览器自带) ===== */
function speak(text) {
  if (!window.speechSynthesis) return;
  window.speechSynthesis.cancel(); // 停止当前发音
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  u.rate = 0.85; // 稍微放慢适合儿童
  window.speechSynthesis.speak(u);
}

/* ===== 数据 ===== */
// 请确保同级目录下有 images 文件夹，并按以下名称放置图片
// 如果没有图片，代码会自动降级显示 emoji
const PAGES = [
  { e: '🐶', img: 'images/dog.jpg', t: 'A dog runs.', core: ['dog', 'runs'] },
  { e: '🐸', img: 'images/frog.jpg', t: 'A frog jumps.', core: ['frog', 'jumps'] },
  { e: '🐦', img: 'images/bird.jpg', t: 'A bird hops.', core: ['bird', 'hops'] },
  { e: '🐒', img: 'images/monkey.jpg', t: 'A monkey climbs.', core: ['monkey', 'climbs'] },
  { e: '🐍', img: 'images/snake.jpg', t: 'A snake slides.', core: ['snake', 'slides'] },
  { e: '🐟', img: 'images/fish.jpg', t: 'A fish swims.', core: ['fish', 'swims'] },
  { e: '🐻', img: 'images/bear.jpg', t: 'A bear walks.', core: ['bear', 'walks'] },
  { e: '🧸', img: 'images/teddy.jpg', t: 'Just like Teddy!', core: ['Teddy'] }
];

const WORDS = ['jump', 'swim', 'slide', 'hop']; // 徽章词

let cur = 0, picked = null, audioBlob = null, recorder = null, chunks = [];
let mistakes = new Set(), correctCount = 0, totalAttempts = 0;
let aiIndex = 0; // 修复AI模拟永远显示 run 的问题

/* ===== 导航 ===== */
function go(n) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('s' + n).classList.add('active');
  document.getElementById('backBtn').style.visibility = n === 1 ? 'hidden' : 'visible';
  document.getElementById('bar').style.width = (n / 6 * 100) + '%';
  document.getElementById('stepLabel').textContent = n + '/6';
  if (n === 2) initReader();
  if (n === 4) initSort();
  if (n === 6) buildReport();
}
function goBack() {
  const c = document.querySelector('.screen.active');
  const id = +c.id.slice(1);
  if (id > 1) go(id - 1);
}

/* 屏1 */
function pick(el) {
  document.querySelectorAll('.predict-card').forEach(c => c.classList.remove('picked'));
  el.classList.add('picked');
  picked = el.dataset.v;
}

/* 屏2 阅读器 */
function initReader() { cur = 0; renderPage(); }

function renderPage() {
  const p = PAGES[cur];
  const imgBox = document.getElementById('pageImg');
  
  // 渲染图片 + 兜底 Emoji
  imgBox.innerHTML = `
    <span class="tag">真实摄影</span>
    <img src="${p.img}" onerror="this.style.display='none';document.getElementById('pageEmoji').style.display='block';" style="width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;z-index:1;">
    <span id="pageEmoji" style="display:none;font-size:64px;">${p.e}</span>
  `;

  // 渲染文字（带点击发音）
  const sentenceBox = document.getElementById('sentence');
  sentenceBox.innerHTML = p.t.split(/\s+/).map(w => {
    const clean = w.replace(/[^a-zA-Z]/g, '').toLowerCase();
    const isCore = p.core.includes(clean) ? 1 : 0;
    return `<span class="word" data-core="${isCore}" onclick="tapWord(this,'${clean}')">${w}</span>`;
  }).join(' ');

  // 渲染进度点
  const d = document.getElementById('dots');
  d.innerHTML = PAGES.map((_, i) => `<span class="${i === cur ? 'on' : ''}"></span>`).join('');
}

function tapWord(el, w) {
  el.classList.toggle('lit');
  speak(w); // 点击朗读单词
}

function replaySentence() {
  speak(PAGES[cur].t);
}

function nextPage() {
  if (cur < PAGES.length - 1) {
    cur++;
    renderPage();
  } else {
    go(3);
  }
}

/* 录音 */
async function toggleRec() {
  const btn = document.getElementById('recBtn');
  if (btn.dataset.on) {
    if (recorder && recorder.state !== 'inactive') recorder.stop();
    btn.textContent = '🎙️ 跟读';
    btn.dataset.on = '';
    return;
  }
  try {
    const s = await navigator.mediaDevices.getUserMedia({ audio: true });
    recorder = new MediaRecorder(s);
    chunks = [];
    recorder.ondataavailable = e => chunks.push(e.data);
    recorder.onstop = () => {
      audioBlob = new Blob(chunks, { type: 'audio/webm' });
      s.getTracks().forEach(t => t.stop());
    };
    recorder.start();
    btn.textContent = '⏹ 停止';
    btn.dataset.on = '1';
  } catch (e) {
    alert('麦克风不可用（需 localhost/https），演示模式已记录一次跟读');
    audioBlob = 'mock';
  }
}

function playMyVoice() {
  if (!audioBlob) {
    document.getElementById('voiceHint').textContent = '还没录过音';
    return;
  }
  if (audioBlob === 'mock') {
    document.getElementById('voiceHint').textContent = '演示音频（未授权麦克风）';
    return;
  }
  new Audio(URL.createObjectURL(audioBlob)).play();
}

/* 屏3 答题 */
function quiz3(el, right) {
  totalAttempts++;
  if (right) {
    el.classList.add('right');
    document.getElementById('fb3').textContent = 'Yes! A snake slides.';
    if (!el.dataset.done) {
      el.dataset.done = '1';
      correctCount++;
    }
    // 【修复】原来错写为 go(5)，导致跳过屏 4
    setTimeout(() => go(4), 900);
  } else {
    el.classList.add('wrong');
    document.getElementById('fb3').textContent = 'Listen again...';
    speak('A snake slides.');
    setTimeout(() => el.classList.remove('wrong'), 500);
  }
}

/* 屏4 排序（修复核心 bug） */
const ORDER_ANS = [0, 1, 2]; // 蹲 -> 蹬 -> 腾
const CARDS = ['🦵蹲', '🚀蹬', '✨腾'];
let order = [null, null, null];
let selIdx = null;

function initSort() {
  order = [null, null, null];
  selIdx = null;
  document.getElementById('fb4').textContent = '';
  document.getElementById('checkOrder').style.display = 'none';
  renderSlots();
  renderPool();
}

function renderPool() {
  const p = document.getElementById('pool');
  p.innerHTML = '';
  CARDS.forEach((c, i) => {
    const d = document.createElement('div');
    const used = order.includes(i);
    d.className = 'pool-card' + (used ? ' used' : '') + (selIdx === i ? ' selected' : '');
    d.textContent = c;
    d.onclick = () => {
      if (used) return;
      selIdx = i;
      renderPool();
    };
    p.appendChild(d);
  });
}

function renderSlots() {
  document.querySelectorAll('.slot').forEach((s, i) => {
    const cardIdx = order[i];
    if (cardIdx !== null) {
      s.innerHTML = `<span class="num">${i + 1}</span>${CARDS[cardIdx]}`;
      s.classList.add('filled');
    } else {
      s.innerHTML = '';
      s.classList.remove('filled');
    }
  });
  
  // 如果三个格子都填满了，显示检查按钮
  document.getElementById('checkOrder').style.display = order.every(v => v !== null) ? 'block' : 'none';
}

function slotClick(i) {
  if (selIdx === null) return;
  
  // 如果点击的槽位已经有卡片了，先把之前的卡片退回池子
  if (order[i] !== null) {
    // 可以设计为直接替换
  }
  order[i] = selIdx;
  selIdx = null;
  renderSlots();
  renderPool();
}

function checkOrder() {
  const ok = order.every((v, i) => v === ORDER_ANS[i]);
  document.getElementById('fb4').textContent = ok ? '✅ Correct! A frog jumps!' : 'Try again!';
  if (ok) {
    speak('Correct! A frog jumps!');
    setTimeout(() => go(5), 800);
  } else {
    speak('Try again!');
  }
}

/* 屏5 摄像头与 AI */
async function openCam() {
  try {
    const v = document.createElement('video');
    v.autoplay = v.muted = v.playsInline = true;
    const s = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
    v.srcObject = s;
    const box = document.getElementById('camBox');
    box.innerHTML = '';
    box.appendChild(v);
  } catch (e) {
    document.getElementById('camBox').innerHTML = '<div class="placeholder">摄像头不可用，请用「模拟 AI 识别」</div>';
  }
}

function simulateAI() {
  const acts = ['run', 'jump', 'dance'];
  const el = document.getElementById('recognized');
  el.textContent = '识别中...';
  setTimeout(() => {
    el.textContent = '✅ ' + acts[aiIndex % 3];
    document.getElementById('unlockVideo').style.display = 'block';
    setTimeout(() => {
      document.getElementById('unlockVideo').style.display = 'none';
      el.textContent = '';
    }, 2500);
    aiIndex++;
  }, 1200);
}

/* 屏6 报告 */
function buildReport() {
  const wall = document.getElementById('badgeWall');
  wall.innerHTML = '';
  WORDS.forEach(w => {
    const d = document.createElement('div');
    d.className = 'badge got';
    d.textContent = w === 'jump' ? '🐸' : w === 'swim' ? '🐟' : w === 'slide' ? '🐍' : '🐦';
    d.title = w;
    wall.appendChild(d);
  });

  const mins = Math.floor(Math.random() * 3) + 5;
  const rate = totalAttempts > 0 ? `${correctCount}/${totalAttempts}` : '1/1';

  document.getElementById('parentReport').innerHTML = `
    <b>本次阅读</b> ${mins} 分钟 · 8 页读完 · 核心词 4 个<br>
    <b>理解题</b> ${rate} 首次答对<br>
    <b>跨册迁移</b> 上次会说 <i>Let's dance</i>，这次会说 <i>A frog jumps</i><br>
    <b>建议</b> 在家问 "Can a fish run?"
  `;
}

function switchTab(i) {
  document.querySelectorAll('.tabs span').forEach((s, j) => s.classList.toggle('on', j === i));
  document.querySelectorAll('.tab-pane').forEach((p, j) => p.classList.toggle('on', j === i));
}

function factAns(el, right) {
  // 【修复】恢复所有按钮透明度
  document.querySelectorAll('#s6 .btn-outline').forEach(b => b.style.opacity = '1');
  el.style.opacity = '.6';
  document.getElementById('factOk').style.display = right ? 'block' : 'none';
  if(right) speak('Yes! Teddy is pretend, the frog is real.');
}
